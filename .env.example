# PostgreSQL ulanish manzillari.
# Neon'da: DATABASE_URL = "pooled" ulanish (oxirida ?sslmode=require&pgbouncer=true),
#          DIRECT_URL   = "direct" ulanish (migratsiyalar uchun).
# Lokal muhitda ikkalasi bir xil bo'lishi mumkin.
DATABASE_URL="postgresql://foydalanuvchi:parol@host:5432/baza?sslmode=require"
DIRECT_URL="postgresql://foydalanuvchi:parol@host:5432/baza?sslmode=require"

# JWT tokenlarni imzolash uchun maxfiy kalit (uzun, tasodifiy bo'lsin).
JWT_SECRET="bu-yerga-uzun-tasodifiy-maxfiy-kalit"
